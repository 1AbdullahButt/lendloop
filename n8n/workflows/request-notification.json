    {
      "parameters": {
        "jsCode": "// Mock \"Send\": stands in for an SMTP node. Appends one JSON line per notification to the\n// outbox file and returns it so it also shows in the execution log. The address is masked in\n// both places; only a real email node would ever need the full address.\nconst fs = require('fs');\n\n// Keep only the first character and the domain: enough to tell recipients apart in a log.\nconst maskEmail = (email) => {\n  const parts = String(email || '').split('@');\n  if (parts.length !== 2 || !parts[0] || !parts[1]) return '***';\n  return parts[0].slice(0, 1) + '***@' + parts[1];\n};\nconst oneLine = (value, max) => String(value == null ? '' : value).replace(/\\s+/g, ' ').trim().slice(0, max);\n\nconst outbox = $env.LENDLOOP_MOCK_OUTBOX;\nif (!outbox) throw new Error('LENDLOOP_MOCK_OUTBOX is not set in the n8n environment');\n\nconst sent = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const entry = {\n    at: new Date().toISOString(),\n    channel: 'request-notification',\n    eventId: j.eventId,\n    type: j.type,\n    to: maskEmail(j.recipientEmail),\n    subject: oneLine(j.subject, 200),\n    message: oneLine(j.message, 500),\n  };\n  fs.appendFileSync(outbox, JSON.stringify(entry) + '\\n');\n  sent.push({ json: entry });\n}\nreturn sent;\n"
      },
