      "parameters": {
        "jsCode": "// Verifies X-LendLoop-Signature = \"sha256=\" + hex(HMAC-SHA256(secret, timestamp + \".\" + rawBody)).\n// The HMAC is computed over the exact bytes the Webhook received (Raw Body option), never over\n// re-serialised JSON: key order, whitespace or unicode escaping could differ from what Convex signed.\nconst crypto = require('crypto');\n\nconst secret = $env.CONVEX_TO_N8N_SECRET;\nif (!secret) {\n  // Misconfiguration, not a bad request: fail loudly so the error workflow raises an alert.\n  throw new Error('CONVEX_TO_N8N_SECRET is not set in the n8n environment');\n}\n\nconst MAX_SKEW_MS = 5 * 60 * 1000;\nconst item = $input.first();\n// Node's HTTP server lowercases header names.\nconst headers = item.json.headers || {};\nconst timestamp = String(headers['x-lendloop-timestamp'] || '');\nconst signature = String(headers['x-lendloop-signature'] || '');\n\n// Only a reason for the execution log; the caller always gets a bare 401.\nconst reject = (reason) => [{ json: { valid: false, reason } }];\n\n// The helper resolves both inline (base64) and stored (filesystem/database) binary data.\nconst binaryHelpers = (this && this.helpers) || (typeof helpers !== 'undefined' ? helpers : undefined);\n\nasync function readRawBody() {\n  const binary = item.binary && item.binary.data;\n  if (!binary) return null;\n  if (binaryHelpers && typeof binaryHelpers.getBinaryDataBuffer === 'function') {\n    return await binaryHelpers.getBinaryDataBuffer(0, 'data');\n  }\n  // Fallback: inline binary data is the base64 of the exact bytes received.\n  if (!binary.id && typeof binary.data === 'string') return Buffer.from(binary.data, 'base64');\n  throw new Error('Raw body is stored externally and getBinaryDataBuffer is unavailable');\n}\n\nif (!/^\\d{1,16}$/.test(timestamp)) return reject('missing or malformed timestamp');\nif (Math.abs(Date.now() - Number(timestamp)) > MAX_SKEW_MS) return reject('stale timestamp');\nif (!/^sha256=[0-9a-f]{64}$/.test(signature)) return reject('missing or malformed signature');\n\nconst rawBody = await readRawBody();\nif (!rawBody) {\n  // Without the raw bytes there is nothing safe to verify; never fall back to $json.body.\n  return reject('raw body unavailable (enable Webhook option Raw Body)');\n}\n\nconst expected = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.', 'utf8')\n  .update(rawBody)\n  .digest();\nconst received = Buffer.from(signature.slice('sha256='.length), 'hex');\n// Both are 32 bytes (the regex above guarantees the received length), as timingSafeEqual requires.\nif (received.length !== expected.length || !crypto.timingSafeEqual(received, expected)) {\n  return reject('bad signature');\n}\n\nlet payload;\ntry {\n  payload = JSON.parse(rawBody.toString('utf8'));\n} catch (error) {\n  return reject('signed body is not JSON');\n}\n\n// Pass on only the fields the notification needs; headers and the raw body stop here.\nreturn [{\n  json: {\n    valid: true,\n    eventId: payload.eventId,\n    type: payload.type,\n    loanId: payload.loanId,\n    toolName: payload.toolName,\n    recipientName: payload.recipientName,\n    recipientEmail: payload.recipientEmail,\n    startDate: payload.startDate,\n    endDate: payload.endDate,\n  },\n}];\n"
      },
