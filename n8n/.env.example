# Names only. Copy to n8n/.env (git-ignored) and fill in locally; docker-compose reads it.

# Same value as the Convex env var: verifies webhooks from Convex (request-notification)
CONVEX_TO_N8N_SECRET=
# Same value as the Convex env var: signs calls to Convex (overdue-reminders)
N8N_TO_CONVEX_SECRET=
# Your Convex HTTP actions origin, https://<deployment>.convex.site (no trailing slash)
CONVEX_SITE_URL=
# Optional: the production deployment's https://<deployment>.convex.site, so overdue reminders
# also reach the live site. Leave empty to cover dev only.
CONVEX_SITE_URL_PROD=
# Optional: production's N8N_TO_CONVEX_SECRET when it differs from dev's (falls back to it)
N8N_TO_CONVEX_SECRET_PROD=
# Public URL of this n8n (your cloudflared tunnel), so n8n shows the right production webhook URL
WEBHOOK_URL=
# Optional: Slack or Discord incoming webhook for error alerts; leave empty to use the mock outbox only
ALERT_WEBHOOK_URL=
