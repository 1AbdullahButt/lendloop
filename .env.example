# Names only. Copy to .env.local (Next.js) and set Convex values with `npx convex env set NAME value`.

# --- Next.js (.env.local) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex (npx convex env set ...) ---
CLERK_JWT_ISSUER_DOMAIN=
ADMIN_EMAILS=
N8N_REQUEST_WEBHOOK_URL=
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# --- n8n (n8n/.env, read by docker-compose) ---
# CONVEX_TO_N8N_SECRET=   same value as above, used to verify incoming webhooks
# N8N_TO_CONVEX_SECRET=   same value as above, used to sign calls to Convex
# CONVEX_SITE_URL=        e.g. https://<deployment>.convex.site
# CONVEX_SITE_URL_PROD=   optional, the production deployment's .convex.site (overdue reminders)
# N8N_TO_CONVEX_SECRET_PROD= optional, production's N8N_TO_CONVEX_SECRET if it differs
